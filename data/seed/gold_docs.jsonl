"start": 870, "end": 894, "text": "ТОВ «Вигадана Логістика»", "category": "ORG", "id_type": "QI", "entity_id": "E7", "case": "gen", "name_part": null, "attr": null, "owner": "E1", "edrsr_type": null}, {"start": 906, "end": 921, "text": "Ковальчинського", "category": "PERSON", "id_type": "DI", "entity_id": "E1", "case": "gen", "name_part": "surname", "attr": null, "owner": "E1", "edrsr_type": "ОСОБА"}, {"start": 922, "end": 928, "text": "Тараса", "category": "PERSON", "id_type": "DI", "entity_id": "E1", "case": "gen", "name_part": "first", "attr": null, "owner": "E1", "edrsr_type": "ОСОБА"}, {"start": 929, "end": 938, "text": "Петровича", "category": "PERSON", "id_type": "DI", "entity_id": "E1", "case": "gen", "name_part": "patronymic", "attr": null, "owner": "E1", "edrsr_type": "ОСОБА"}, {"start": 964, "end": 974, "text": "48 600 грн", "category": "QUANTITY", "id_type": "QI", "entity_id": "E17", "case": null, "name_part": null, "attr": null, "owner": "E1", "edrsr_type": null}]}
{"doc_id": "D003", "person_id": "P0003", "target_entity_id": "E1", "genre": "court", "doc_year": 2023, "text": "Справа № 456/2210/23\n\nРІШЕННЯ\nІМЕНЕМ УКРАЇНИ\n\n3 жовтня 2023 року Стрийський міськрайонний суд Львівської області розглянув цивільну справу за позовом Задорожненко Ірини Олегівни до Вигаданого Остапа Романовича про стягнення боргу за договором позики.\n\nПозивачка, 1985 р. н., медична сестра Стрийської центральної районної лікарні, пояснила, що 15 січня 2023 року передала відповідачеві 30 000 грн на строк до 1 червня 2023 року, проте кошти не повернуто. Ірина Олегівна також повідомила, що не перебуває у шлюбі і сама доглядає матір похилого віку. Відповідач Вигаданий О. Р. у судове засідання не з’явився. Заслухавши пояснення Задорожненко І. О., суд дійшов висновку, що позов підлягає задоволенню.", "spans": [{"start": 7, "end": 20, "text": "№ 456/2210/23", "category": "CODE", "id_type": "DI", "entity_id": "E2", "case": null, "name_part": null, "attr": null, "owner": null, "edrsr_type": null}, {"start": 46, "end": 64, "text": "3 жовтня 2023 року", "category": "DATETIME", "id_type": "QI", "entity_id": "E3", "case": null, "name_part": null, "attr": null, "owner": null, "edrsr_type": null}, {"start": 65, "end": 112, "text": "Стрийський міськрайонний суд Львівської області", "category": "ORG", "id_type": "QI", "entity_id": "E4", "case": "nom", "name_part": null, "attr": "settlement", "owner": "E1", "edrsr_type": null}, {"start": 150, "end": 162, "text": "Задорожненко", "category": "PERSON", "id_type": "DI", "entity_id": "E1", "case": "gen", "name_part": "surname", "attr": null, "owner": "E1", "edrsr_type": "ОСОБА"}, {"start": 163, "end": 168, "text": "Ірини", "category": "PERSON", "id_type": "DI", "entity_id": "E1", "case": "gen", "name_part": "first", "attr": null, "owner": "E1", "edrsr_type": "ОСОБА"}, {"start": 169, "end": 177, "text": "Олегівни", "category": "PERSON", "id_type": "DI", "entity_id": "E1", "case": "gen", "name_part": "patronymic", "attr": nu